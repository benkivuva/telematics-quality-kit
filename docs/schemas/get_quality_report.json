{
  "$defs": {
    "CheckOutput": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Metric",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "PASS",
            "WARN",
            "BLOCK"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "name",
        "verdict",
        "score",
        "metric"
      ],
      "title": "CheckOutput",
      "type": "object"
    },
    "DataQualityOutput": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "blocked_vehicle_count": {
          "default": 0,
          "minimum": 0,
          "title": "Blocked Vehicle Count",
          "type": "integer"
        },
        "blocked_vehicles": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Vehicles",
          "type": "array"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckOutput"
          },
          "title": "Checks",
          "type": "array"
        },
        "label": {
          "enum": [
            "trust it",
            "be careful",
            "don't trust it"
          ],
          "title": "Label",
          "type": "string"
        },
        "symbol": {
          "enum": [
            "\u2713",
            "\u26a0",
            "\u26d4"
          ],
          "title": "Symbol",
          "type": "string"
        },
        "trust_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Trust Score",
          "type": "number"
        },
        "usable_for_decision": {
          "title": "Usable For Decision",
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "PASS",
            "WARN",
            "BLOCK"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/WindowOutput"
        },
        "withheld": {
          "items": {
            "type": "string"
          },
          "title": "Withheld",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "label",
        "symbol",
        "trust_score",
        "usable_for_decision",
        "caveats",
        "as_of",
        "window"
      ],
      "title": "DataQualityOutput",
      "type": "object"
    },
    "VehicleOutput": {
      "additionalProperties": false,
      "properties": {
        "data_quality": {
          "$ref": "#/$defs/DataQualityOutput"
        },
        "device_time": {
          "format": "date-time",
          "title": "Device Time",
          "type": "string"
        },
        "latitude": {
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "title": "Longitude",
          "type": "number"
        },
        "speed_kph": {
          "title": "Speed Kph",
          "type": "number"
        },
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        }
      },
      "required": [
        "vehicle_id",
        "device_time",
        "latitude",
        "longitude",
        "speed_kph",
        "data_quality"
      ],
      "title": "VehicleOutput",
      "type": "object"
    },
    "WindowOutput": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "WindowOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A fleet summary, or one vehicle's report when a vehicle_id is supplied.",
  "properties": {
    "data_quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataQualityOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "device_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Time"
    },
    "fleet_trust_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fleet Trust Score"
    },
    "latitude": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latitude"
    },
    "longitude": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Longitude"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "speed_kph": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Kph"
    },
    "trust_score_histogram": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trust Score Histogram"
    },
    "vehicle_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vehicle Count"
    },
    "vehicle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vehicle Id"
    },
    "vehicles": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/VehicleOutput"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vehicles"
    },
    "verdict_counts": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict Counts"
    }
  },
  "title": "QualityReportOutput",
  "type": "object"
}
