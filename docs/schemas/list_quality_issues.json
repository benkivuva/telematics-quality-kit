{
  "$defs": {
    "CheckOutput": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Metric",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "PASS",
            "WARN",
            "BLOCK"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "name",
        "verdict",
        "score",
        "metric"
      ],
      "title": "CheckOutput",
      "type": "object"
    },
    "DataQualityOutput": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckOutput"
          },
          "title": "Checks",
          "type": "array"
        },
        "label": {
          "enum": [
            "trust it",
            "be careful",
            "don't trust it"
          ],
          "title": "Label",
          "type": "string"
        },
        "symbol": {
          "enum": [
            "\u2713",
            "\u26a0",
            "\u26d4"
          ],
          "title": "Symbol",
          "type": "string"
        },
        "trust_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Trust Score",
          "type": "number"
        },
        "usable_for_decision": {
          "title": "Usable For Decision",
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "PASS",
            "WARN",
            "BLOCK"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/WindowOutput"
        },
        "withheld": {
          "items": {
            "type": "string"
          },
          "title": "Withheld",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "label",
        "symbol",
        "trust_score",
        "usable_for_decision",
        "caveats",
        "as_of",
        "window"
      ],
      "title": "DataQualityOutput",
      "type": "object"
    },
    "QualityIssueOutput": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "suggested_next_check": {
          "title": "Suggested Next Check",
          "type": "string"
        },
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "WARN",
            "BLOCK"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "vehicle_id",
        "check",
        "verdict",
        "score",
        "suggested_next_check"
      ],
      "title": "QualityIssueOutput",
      "type": "object"
    },
    "WindowOutput": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "WindowOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_quality": {
      "$ref": "#/$defs/DataQualityOutput"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/QualityIssueOutput"
      },
      "title": "Issues",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "issues",
    "data_quality"
  ],
  "title": "QualityIssuesOutput",
  "type": "object"
}
