# 1. Baseline
fleet
tools
ls --limit 5
get TRK-0001
explain TRK-0001 freshness
report TRK-0001 --verbose
call get_quality_report {"verbose": false}

# 2. Inject a fault on LRY-0001 (Tests the cascade bug)
inject gps_drift LRY-0001 --severity high

# 3. Advance time to evaluate the fault
advance 6m
fleet

# 4. Test the expectations and filters
expect verdict LRY-0001 BLOCK
ls --worse-than WARN

# 5. Test fault listing and clearing
faults
clear all
fleet

# 6. Test simulator controls
pause
resume
speed 10x
reset
seed 99
fleet
exit
